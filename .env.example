# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- InfluxDB v2 ---
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=replace_with_influx_api_token
INFLUX_ORG=kalbe-utility
INFLUX_BUCKET=neraca_air
INFLUX_MEASUREMENT=flow_reading
# Set to "false" to run purely on in-memory mock data (useful before InfluxDB is provisioned)
INFLUX_ENABLED=false

# --- RS485 / Modbus RTU gateway (used by src/integrations/rs485-reader.js) ---
RS485_SERIAL_PORT=/dev/ttyUSB0
RS485_BAUD_RATE=9600
RS485_POLL_INTERVAL_MS=30000
# Where the RS485 worker should POST readings to (this same backend)
INGEST_URL=http://localhost:4000/api/ingest
INGEST_API_KEY=replace_with_shared_secret

# --- IoT / MQTT bridge (optional, if flow meters publish over MQTT instead of RS485) ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=aquaflow/kalbe/meters
